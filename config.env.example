# Переопределения поверх config.json. Скопируйте в config.env и заполните.
# Приоритет: переменные окружения ОС > config.env > config.json

TARGET_GAME=Hunt: Showdown 1896
CLIENT_ID=kd1unb4b3q4t58fwlpcbzcbnm76a8fp

# Leave BOT_PLATFORM empty for the first-launch choice (existing Telegram settings are adopted).
# telegram | discord | none
BOT_PLATFORM=
DISCORD_BOT_TOKEN=
DISCORD_ADMIN_ID=

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=

ACCOUNTS_FILE=account.txt
# Beacon interval (minimum 60 seconds). HLS is checked separately every 20 seconds.
HEARTBEAT_INTERVAL_SEC=60
CAMPAIGN_POLL_INTERVAL_SEC=120
JITTER_SEC=20
GROUP_SESSION_MINUTES=60
LOG_DIR=logs
USE_PUBSUB=false
